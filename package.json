{
  "name": "mova",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18n-js": "^4.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:types": "node scripts/check-typed-routes.mjs",
    "lint": "expo lint --max-warnings 0",
    "test": "jest --passWithNoTests",
    "export:web": "npx expo export -p web",
    "check": "npm run typegen && npm run typecheck && npm run test:types && npm run lint && npm run test && npm run export:web",
    "scan:secrets": "gitleaks dir . --config .gitleaks.toml --redact --no-banner",
    "scan:secrets:history": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "scan:secrets:staged": "gitleaks git . --pre-commit --staged --config .gitleaks.toml --redact --no-banner",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "private": true,
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  }
}
