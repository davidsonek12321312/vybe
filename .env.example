# MOVA environment template (Spec 002). Copy to .env.local, which is gitignored.
# Only PUBLIC values belong here. Never put a Supabase secret key (sb_secret_...)
# or a service-role key in any EXPO_PUBLIC_ variable: they end up in the app bundle.

# sample = fictional events, no backend; supabase = live data from Supabase
EXPO_PUBLIC_MOVA_DATA_SOURCE=sample

# Default city slug (cities are data; see docs/DECISIONS.md ADR-0016)
EXPO_PUBLIC_DEFAULT_CITY=da-nang

# Existing MOVA project (ADR-0010). Local stack: http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=https://vozitoaqntixingqwuiw.supabase.co

# Publishable key only (sb_publishable_...). Local stack: see `npx supabase status`
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site origin used for share links on native, e.g. https://mova.example
EXPO_PUBLIC_SITE_URL=

# Set to true only for local previews against the local Supabase stack
EXPO_PUBLIC_ALLOW_LOCAL_SUPABASE=false
